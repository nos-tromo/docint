FROM ghcr.io/astral-sh/uv:0.12.11@sha256:79c6f4776b851471cc73b7d21d0cc834bb94383c292e83640d27eff512864df7 AS uv

# ---- Builder: install build deps and assemble the venv ----
FROM docker.io/library/python:3.11-slim-trixie@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS builder
COPY --from=uv /uv /bin/uv

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_DOWNLOADS=0 \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    build-essential python3-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-install-project

# Copy the project into the image
COPY . /app

# Sync the project
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    uv sync --locked --no-dev

# Bake the embedding tokenizer into the image (~21 MB, tokenizer files only)
ARG EMBED_TOKENIZER_REPO=BAAI/bge-m3
RUN --mount=type=cache,target=/root/.cache/huggingface \
    EMBED_TOKENIZER_REPO=${EMBED_TOKENIZER_REPO} \
    HF_HUB_CACHE=/root/.cache/huggingface/hub \
    /app/.venv/bin/load-models \
    && cp -r /root/.cache/huggingface/hub /app/hf-hub

# ---- Runtime: only runtime libs and the prebuilt venv ----
FROM docker.io/library/python:3.11-slim-trixie@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    HF_HUB_CACHE=/app/hf-hub

WORKDIR /app

# libmagic1: file-type detection. (libgl1 was opencv's — dropped with it.)
# pango/harfbuzz/fontconfig/gdk-pixbuf + Noto fonts: WeasyPrint's native runtime
# libraries and a broad multi-script font set (Latin/Cyrillic/CJK) for the PDF
# report export.
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    libmagic1 \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libfontconfig1 libgdk-pixbuf-2.0-0 \
    fonts-dejavu-core fonts-noto-core fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# Non-root runtime user (deploy ADR 0001). /app stays root-owned and read-only to the app user
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app \
       --shell /usr/sbin/nologin app
ENV HOME=/home/app

COPY --from=builder /app /app

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "docint.core.api:app", "--host", "0.0.0.0", "--port", "8000"]
