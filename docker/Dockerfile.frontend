# ---- Build the React SPA ----
FROM docker.io/library/node:26-alpine@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5 AS builder
WORKDIR /build

RUN npm install -g pnpm@9.12.0

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm build

# ---- Serve via nginx ----
FROM docker.io/nginxinc/nginx-unprivileged:1.31-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e

USER root
RUN apk add --no-cache --upgrade 'brotli-libs>=1.2.1-r0' \
    && rm /etc/nginx/conf.d/default.conf

ENV DOCINT_CLIENT_MAX_BODY_SIZE=1g
ENV DOCINT_API_MAX_BODY_SIZE=64m

COPY frontend/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY frontend/nginx/security-headers-framable.conf /etc/nginx/security-headers-framable.conf
COPY frontend/nginx/default.conf /etc/nginx/templates/default.conf.template

COPY --from=builder /build/dist /usr/share/nginx/html

USER 101
EXPOSE 8080

# nginx:alpine entrypoint already runs nginx in foreground
