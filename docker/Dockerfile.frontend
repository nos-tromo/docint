# ---- Build the React SPA ----
FROM docker.io/library/node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS builder
WORKDIR /build

RUN npm install -g pnpm@9.12.0

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm build

# ---- Serve via nginx ----
FROM docker.io/nginxinc/nginx-unprivileged:1.31-alpine@sha256:b9241c6e7b8e9a862f129d8d4199ab64b10390949a78bdd5603379b32c844083

USER root
RUN rm /etc/nginx/conf.d/default.conf

ENV DOCINT_CLIENT_MAX_BODY_SIZE=1g
ENV DOCINT_API_MAX_BODY_SIZE=64m

COPY frontend/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY frontend/nginx/security-headers-framable.conf /etc/nginx/security-headers-framable.conf
COPY frontend/nginx/default.conf /etc/nginx/templates/default.conf.template

COPY --from=builder /build/dist /usr/share/nginx/html

USER 101
EXPOSE 8080

# nginx:alpine entrypoint already runs nginx in foreground
