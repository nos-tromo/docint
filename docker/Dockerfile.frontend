ARG NODE_IMAGE=docker.io/library/node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
# nginx-unprivileged: runs as uid 101, listens on 8080, pid/temp under /tmp
# (deploy ADR 0001 non-root mandate); templates/envsubst mechanism intact.
ARG NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.27-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0

# ---- Build the React SPA ----
FROM $NODE_IMAGE AS builder
WORKDIR /build

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm build

# ---- Serve via nginx ----
FROM $NGINX_IMAGE

USER root
RUN rm /etc/nginx/conf.d/default.conf

ENV DOCINT_CLIENT_MAX_BODY_SIZE=1g

COPY frontend/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY frontend/nginx/security-headers-framable.conf /etc/nginx/security-headers-framable.conf
COPY frontend/nginx/default.conf /etc/nginx/templates/default.conf.template

COPY --from=builder /build/dist /usr/share/nginx/html

USER 101
EXPOSE 8080

# nginx:alpine entrypoint already runs nginx in foreground
