# docint — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)
#
# Both consumers read the same .env: the backend through load_dotenv(), and
# Docker through env_file in docker/compose.yaml. Every variable docint reads,
# with its default, is in docs/configuration.md.
#
# The values shown are those of the compose shape. Under Docker, compose
# points docint at the vllm router; a run outside Docker (uv run) keeps the
# code defaults, which are ollama on localhost (Inference).
#
# Keep a setting commented to keep its default: for many keys an empty value
# is not the same as unset.
#
# Booleans accept true, 1 and yes (any case) and nothing else. on, a trailing
# blank or a typo all read as false, which silently switches off a setting
# that defaults to true.
#
# ${OTHER_VAR} is expanded by both consumers. Prefer plain literals unless you
# want a host-shell override, and never write a bare ${VAR} without a
# :-default: on a clean host it resolves to an empty string.

# =============================================================================
# Required
# =============================================================================

# The router's master key: the same value as OPENAI_API_KEY in vllm-service's
# .env; make env fills it in. The chat client sends it, and the embed,
# sparse, rerank and OCR lanes inherit it (Inference). With the key left out
# of .env entirely, the code sends sk-no-key-required, which suits a server
# that checks no key.
# [required] [secret] [shared: vllm-service]
OPENAI_API_KEY=

# The Qdrant API key: the same value as QDRANT_API_KEY in data-plane's .env,
# whose Qdrant refuses every request without it; make env fills it in. Unset
# sends no key, which only a Qdrant without authentication accepts.
# [required] [secret] [shared: data-plane]
QDRANT_API_KEY=

# =============================================================================
# Auth & identity
# =============================================================================

# The edge gateway authenticates every request and sends the principal and
# its groups in these trusted headers.
# DOCINT_AUTH_HEADER=X-Auth-User
# DOCINT_GROUPS_HEADER=X-Auth-Groups

# The group whose members may operate in another owner's namespace.
# DOCINT_ADMIN_GROUP=admins

# The edge secret restricts that trust to the gateway, which sends it in
# X-Edge-Secret on every request it proxies. Set, identity headers from any
# other caller are ignored, so another container on a shared network cannot
# claim a user or the admin group. Generate it with `make secret` in
# edge-plane, which takes the same value under DOCINT_EDGE_SECRET in its own
# .env. At least 32 characters, or the backend refuses to start. Set it on
# the gateway first: set here while the gateway does not send it yet, every
# request is answered 401. Unset trusts any caller, and startup warns about
# that unless DOCINT_DEFAULT_IDENTITY (Development only) marks a local run.
# [secret] [shared: edge-plane]
# DOCINT_EDGE_SECRET=

# =============================================================================
# Network & proxy
# =============================================================================

# Names of the external networks: the backend joins inference-net (to
# vllm-service) and data-net (to data-plane); the frontend joins edge-net,
# where the edge gateway reaches it as docint-frontend. `make network` creates
# them under these names; override one only if you renamed it.
# INFERENCE_NET=inference-net
# DATA_NET=data-net
# EDGE_NET=edge-net

# Proxy bypass: appended to the backend's NO_PROXY/no_proxy list in
# docker/compose.yaml. It must start with a comma, for example
#   EXTRA_NO_PROXY=,some-extra-host
# EXTRA_NO_PROXY=

# =============================================================================
# Inference
# =============================================================================

# --- Chat endpoint ---

# The provider (ollama, openai or vllm; an unknown value stops startup) and
# the OpenAI-compatible base URL, including /v1. docker/compose.yaml defaults
# both to the vllm router on inference-net. Outside Docker the code defaults
# apply instead:
#   INFERENCE_PROVIDER=ollama
#   OPENAI_API_BASE=http://localhost:11434/v1
# INFERENCE_PROVIDER=vllm
# OPENAI_API_BASE=http://vllm-router:4000/v1

# The chat model's context window and the client timeout in seconds. On vllm
# the window follows CHAT_MAX_MODEL_LEN when that is set, else 8192; on
# ollama and openai it is
#   OPENAI_CTX_WINDOW=4096
# OPENAI_CTX_WINDOW=8192
# OPENAI_TIMEOUT=300

# --- Models ---

# The model defaults follow INFERENCE_PROVIDER; the lines below show vllm's.
# On ollama they are
#   EMBED_MODEL=bge-m3
#   TEXT_MODEL=gpt-oss:20b
#   VISION_MODEL=qwen3.5:9b
# and on openai
#   EMBED_MODEL=text-embedding-3-small
#   EMBED_TOKENIZER_REPO=
#   TEXT_MODEL=gpt-4o
#   VISION_MODEL=gpt-4o

# The chat and generation model.
# TEXT_MODEL=Qwen/Qwen3.5-2B

# Captions images, and reads them while OCR_MODEL is unset.
# VISION_MODEL=Qwen/Qwen3.5-2B

# The model for snippet translation in the UI. Unset, it is TEXT_MODEL.
# TRANSLATE_MODEL=

# The dense embedding model. Against the embed-only CPU container use the
# Hugging Face repo id (BAAI/bge-m3): it always serves bge-m3 and ignores the
# value, but the string is recorded as provenance in session metadata.
# EMBED_MODEL=BAAI/bge-m3

# The tokenizer for counting tokens offline at ingest; empty on openai. The
# image bakes it in as a build argument, so a change needs `make build`.
# EMBED_TOKENIZER_REPO=BAAI/bge-m3

# The sparse model is the same on every provider, since sparse is always
# remote.
# SPARSE_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# NER_MODEL=gliner-community/gliner_large-v2.5

# --- Per-lane endpoints ---

# Every lane defaults to the full vllm-service stack behind the router, so an
# unchanged stack needs none of these. Override a lane only to run its
# standalone CPU shape (embed-only, rerank-only, clip-only, gliner-only,
# topics-only) beside a chat provider that is not vllm.
#
# While unset, the EMBED_*, SPARSE_*, RERANK_* and OCR_* endpoints take
# OPENAI_API_BASE and OPENAI_API_KEY. CLIP_*, NER_* and TOPICS_* do not: they
# default to the router alias and send no key. The router requires one, so on
# the full stack set those three keys to the router key:
#   CLIP_API_KEY=${OPENAI_API_KEY}
#   NER_API_KEY=${OPENAI_API_KEY}
#   TOPICS_API_KEY=${OPENAI_API_KEY}
# The standalone shapes need no key.

# Dense embedding. The OpenAI SDK appends /embeddings, so the base must end
# in /v1, unlike SPARSE_API_BASE against the same container; a missing /v1
# shows as a 404 from the embedding endpoint. On embed-only:
#   EMBED_API_BASE=http://embed-only:8000/v1
# EMBED_API_BASE=
# [secret]
# EMBED_API_KEY=

# Sparse embedding, against the bare host; the timeout follows OPENAI_TIMEOUT
# while unset. On embed-only:
#   SPARSE_API_BASE=http://embed-only:8000
# SPARSE_API_BASE=
# [secret]
# SPARSE_API_KEY=
# SPARSE_TIMEOUT=

# Reranking; the timeout follows OPENAI_TIMEOUT while unset. On rerank-only:
#   RERANK_API_BASE=http://rerank-only:8000
# RERANK_API_BASE=
# [secret]
# RERANK_API_KEY=
# RERANK_TIMEOUT=

# CLIP image and text embedding.
# CLIP_API_BASE=http://vllm-router:4000
# [secret]
# CLIP_API_KEY=
# CLIP_TIMEOUT=30

# GLiNER entity extraction. On gliner-only:
#   NER_API_BASE=http://gliner-only:8000
# NER_API_BASE=http://vllm-router:4000
# [secret]
# NER_API_KEY=
# NER_THRESHOLD=0.3
# NER_TIMEOUT=30

# The topic-model fit. One request holds for the whole fit, so the timeout is
# long (seconds). On topics-only:
#   TOPICS_API_BASE=http://topics-only:8000
# TOPICS_API_BASE=http://vllm-router:4000
# [secret]
# TOPICS_API_KEY=
# TOPICS_TIMEOUT=3600

# --- OCR endpoint ---

# One endpoint answers every "read this image": scanned PDF pages, table
# regions geometry could not recover, and images. Leave OCR_MODEL unset and
# VISION_MODEL reads pages as before, with image OCR off. A layout model
# (dots.mocr, dots.ocr) instead returns bounding boxes, categories and tables
# as HTML, so a scanned page chunks like a digital one; any other model is
# asked for plain text. For example
#   OCR_MODEL=dots-studio/dots.mocr
# OCR_MODEL=
# OCR_API_BASE=
# [secret]
# OCR_API_KEY=

# Seconds one read of an image (an image file, a figure from a PDF, a
# keyframe) may take. Scanned pages and table regions of a PDF use
# PIPELINE_OCR_TIMEOUT instead, which follows OPENAI_TIMEOUT: a page takes a
# minute or two.
# OCR_TIMEOUT=60

# =============================================================================
# docint
# =============================================================================

# --- Core ---

# 1 loads models from the local Hugging Face cache only (airgap).
# DOCINT_OFFLINE=1

# Logging is one stderr sink; retention belongs to the compose logging driver
# (docs/ingestion.md, Observability, explains how to read an ingest run).
# Level: TRACE, DEBUG, INFO, WARNING or ERROR. The interval is the heartbeat,
# in seconds, while one job stage repeats; 0 logs every message (thousands of
# lines on a large ingest).
# LOG_LEVEL=INFO
# LOG_PROGRESS_INTERVAL_S=30

# GET /metrics for the obs-plane scrape target.
# METRICS_ENABLED=true

# en or de: switches the prompts and the UI strings; an unknown value falls
# back to en.
# RESPONSE_LANGUAGE=en

# Read by the vendored tokenizers library, not by docint. Unset, the library
# decides itself (and warns after a fork); false switches it off.
# TOKENIZERS_PARALLELISM=

# --- Backend URLs ---

# Origins allowed to call the API from a browser (the Vite dev server).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read into the host config, but nothing in docint uses them at present.
# BACKEND_PUBLIC_HOST does not inherit BACKEND_HOST: it falls back to the
# same literal.
# BACKEND_HOST=http://localhost:8000
# BACKEND_PUBLIC_HOST=http://localhost:8000

# --- Document OCR ---

# The OCR lane for pages without a text layer, the pixel budget of a page
# rendered for a layout model, and its output budget (raise the tokens for a
# layout model: a page of JSON is long). The pixel budget must NOT exceed the
# server's own cap (vllm-service OCR_MM_PROCESSOR_KWARGS), or the model
# resizes the render itself and answers in a frame the caller never saw;
# below the cap is safe. 2007040 is 28*28*2560.
# PIPELINE_OCR_ENABLED=true
# PIPELINE_OCR_MAX_PIXELS=2007040
# PIPELINE_OCR_MAX_TOKENS=4096

# Re-read tables whose structure geometry could not recover.
# PIPELINE_TABLE_OCR=true

# Reading the text inside an image (a screenshot, a photographed letter, a
# slide). Unset, it is on exactly when OCR_MODEL is set. Keyframes stay off
# until asked: a clip contributes many frames and only slides tend to carry
# text.
# IMAGE_OCR_ENABLED=
# KEYFRAME_OCR_ENABLED=false

# --- PDF pipeline ---

# Ignore cached artifacts and re-run every stage.
# PIPELINE_FORCE_REPROCESS=false

# Characters per area below which a page counts as scanned.
# PIPELINE_TEXT_COVERAGE_THRESHOLD=0.01

# --- Ingestion and chunking ---

# Token budgets of the parent and the child chunks.
# COARSE_CHUNK_SIZE=8192
# FINE_CHUNK_SIZE=1024

# Ingest jobs at once, process-wide; a second job for the same collection is
# still refused (409).
# DOCINT_INGEST_CONCURRENCY=1

# Per-file PDF and image stages run at once, at upload time and in the job;
# clips use NEXTEXT_MAX_CONCURRENCY instead. On upload, a file's heavy stage
# starts as soon as it is uploaded.
# INGEST_PREPROCESS_WORKERS=4
# INGEST_PREPROCESS_ON_UPLOAD=true

# DOCSTORE_BATCH_SIZE=100
# INGESTION_BATCH_SIZE=50
# INGEST_BENCHMARK_ENABLED=false
# INGEST_FAIL_FAST=false

# The SQLite manifest; it also caches Nextext transcripts by media hash.
# INGEST_MANIFEST_ENABLED=true
# STREAMING_READERS_ENABLED=true

# Audio and video extensions routed through the Nextext pre-pass, not the
# generic reader whitelist. Comma-separated; a leading dot is added if
# omitted.
# MEDIA_FILETYPES=.mp4,.mov,.mkv,.webm,.avi,.m4v,.mpg,.mpeg,.mp3,.m4a,.wav,.flac,.aac,.ogg,.opus,.wma

# --- Embedding budget ---

# A value out of range stops startup rather than warning: the batch size
# 1..1024, the context 256..32768 tokens, the retries 0..10. The defaults
# follow INFERENCE_PROVIDER; the lines below show vllm's, where the context
# follows CHAT_MAX_MODEL_LEN when that is set. On ollama they are
#   EMBED_BATCH_SIZE=16
#   EMBED_CTX_TOKENS=2048
#   EMBED_TIMEOUT_SECONDS=1800
# and on openai
#   EMBED_BATCH_SIZE=100
#   EMBED_MAX_RETRIES=2
#   EMBED_TIMEOUT_SECONDS=60
# with EMBED_CTX_TOKENS 8191 for text-embedding-3-* and 8192 otherwise.
# EMBED_BATCH_SIZE=64
# EMBED_CTX_TOKENS=8192
# EMBED_MAX_RETRIES=1
# EMBED_TIMEOUT_SECONDS=600

# --- Retrieval ---

# Hybrid retrieval. Unset, it is on when INFERENCE_PROVIDER is vllm or
# SPARSE_API_BASE is set explicitly, and off otherwise: SPARSE_API_BASE alone
# cannot signal availability, since it inherits OPENAI_API_BASE silently.
# ENABLE_HYBRID=

# auto, compact or refine.
# CHAT_RESPONSE_MODE=auto
# PARENT_CONTEXT_RETRIEVAL_ENABLED=true

# 0 is sparse only, 1 dense only.
# RETRIEVAL_HYBRID_ALPHA=0.5
# RETRIEVE_TOP_K=20

# The most chunks per source document in one answer.
# SOCIAL_SOURCE_DIVERSITY_LIMIT=2

# --- Images as sources ---

# Skip re-embedding an image the companion collection already has.
# IMAGE_CACHE_BY_HASH=true
# IMAGE_INGESTION_ENABLED=true

# The reranker score an image must reach to surface as a source. Below it, an
# image inside the cut is re-scored once against the question's visible cues
# and kept at the description score; the description call has one attempt of
# this many seconds.
# IMAGE_RERANK_MIN_SCORE=0.05
# IMAGE_RESCORE_ENABLED=true
# IMAGE_RESCORE_MIN_SCORE=0.02
# IMAGE_RESCORE_TIMEOUT=10

# CLIP candidates entering the ranking.
# IMAGE_RETRIEVE_TOP_K=5

# Caption and tags, a different task from OCR.
# IMAGE_TAGGING_ENABLED=true

# --- Entities, NER and hate speech ---

# ENABLE_HATE_SPEECH_DETECTION=false
# HATE_SPEECH_MAX_WORKERS=1

# Characters of one document chunk sent to the detector; Nextext transcript
# segments labelled per request, and read-only neighbouring segments on each
# side (0 is none), in tokens.
# HATE_SPEECH_MAX_CHARS=8192
# HATE_SPEECH_WINDOW_TOKENS=1000
# HATE_SPEECH_CONTEXT_TOKENS=300

# NER_ENABLED=true
# NER_MAX_CHARS=1024
# NER_MAX_WORKERS=4

# Comma-separated entity labels; set, they replace the built-in set.
# NER_LABELS=

# Entity resolution, the only way to merge semantically similar entities
# (USA and United States). Auto-resolve runs it as a stage inside the ingest
# job. The threshold (0..1) is the vector-match floor for one canonical
# entity, the tiebreak a conservative LLM adjudication of near-matches, and K
# (1..100) the candidates fetched per surface form; an out-of-range threshold
# or K stops startup.
# RES_AUTO_RESOLVE=true
# RES_EMBED_THRESHOLD=0.86
# RES_LLM_TIEBREAK=true
# RES_VECTOR_K=5

# Analysis, NER, Graph: the SPA seeds its control from the top K and lets the
# user raise it live up to the maximum.
# NER_GRAPH_MAX_TOP_K=500
# NER_GRAPH_TOP_K=80

# --- Graph-assisted retrieval ---

# GRAPHRAG_ENABLED=true
# GRAPHRAG_MAX_NEIGHBORS=6
# GRAPHRAG_MIN_EDGE_WEIGHT=3
# GRAPHRAG_NEIGHBOR_HOPS=2
# GRAPHRAG_TOP_K_NODES=50

# --- Nextext media processing ---

# docint ships no media runtime: each clip is forwarded to a remote Nextext
# service, which returns a transcript plus keyframes. The base must include
# Nextext's /api/v1 prefix: docint calls {base}/jobs, so omitting it 404s
# every request. docker/compose.yaml defaults it to Nextext on the shared
# network, and an empty value counts as unset there, so under Docker media
# are always sent to Nextext. Outside Docker it is unset by default, which
# switches media off: video and audio are then skipped fail-soft, images are
# unaffected.
# NEXTEXT_API_BASE=http://nextext-backend:8000/api/v1

# docint calls Nextext directly, not through the gateway, so it authenticates
# with a service token, sent as Authorization: Bearer. It must equal the token
# Nextext's NEXTEXT_SERVICE_TOKENS lists for docint; make env fills it in.
# Nextext identifies docint as service:<entry name> (service:docint for the
# entry docint=<token>), a namespace no user identity can take. docint's
# principal there thus changes from docint to service:docint once the token
# matches, and jobs started under one are invisible to the other: switch with
# no Nextext job in flight. Generate the token with `make secret` in
# edge-plane: Nextext refuses tokens under 32 characters, duplicates, and one
# equal to its NEXTEXT_EDGE_SECRET. Set it BEFORE Nextext sets its
# NEXTEXT_EDGE_SECRET: from then on Nextext ignores identity headers from
# everyone but the gateway, so without the token docint's calls are anonymous
# there (401 in production).
# [secret] [shared: Nextext NEXTEXT_SERVICE_TOKENS]
# NEXTEXT_API_KEY=

# Until then Nextext also accepts the identity below under the header below,
# which docint sends on every request; the header must match Nextext's own.
# Set the identity empty to send no header and rely on Nextext's own default
# instead, but never to a service: value, which Nextext reserves and ignores
# in the header.
# NEXTEXT_AUTH_HEADER=X-Auth-User
# NEXTEXT_IDENTITY=docint

# Clips submitted in parallel per ingest, the poll interval, and the
# wall-clock budget per job before its status becomes timeout (seconds).
# NEXTEXT_MAX_CONCURRENCY=4
# NEXTEXT_POLL_INTERVAL=2
# NEXTEXT_POLL_MAX_SECONDS=1800
# NEXTEXT_TIMEOUT=30

# Keyframe sampling is configured here and forwarded as per-job options.
# docint always asks Nextext to sample (its extraction step is opt-in and
# defaults to off), so these rates are the off-switch: set either to 0 and no
# frames are produced. Nextext rejects a maximum over 200 per clip. The
# cosine (0..1) prunes near-duplicate frames before storage.
# KEYFRAMES_MAX=20
# KEYFRAMES_PER_MINUTE=4
# KEYFRAME_DEDUP_COSINE=0.95

# Album linking. A dossier names most media-to-posting links explicitly, but a
# Telegram photo carries only its own message id, and an album is N
# consecutive messages whose text sits on the last. A media item no posting
# names attaches to the first posting in its dossier at or above its own
# message number, and ONLY when the timestamps agree within the tolerance
# (seconds; widen it only if a crawler stamps media late). That check is what
# keeps a partial export from silently attributing media to the wrong post.
# Explicitly linked media never reach this path.
# SOCIAL_ALBUM_LINK_ENABLED=true
# SOCIAL_ALBUM_TOLERANCE_S=5

# --- Summaries and answer validation ---

# Re-answer once with a reformulated query when validation rejects.
# CORRECTIVE_RETRY_ENABLED=true
# RESPONSE_VALIDATION_ENABLED=true

# Lowering the budget makes the validator judge a partial view.
# RESPONSE_VALIDATION_SOURCE_BUDGET_CHARS=48000

# An agent turn may answer a judgement in two labelled parts: the sources,
# then its own assessment.
# ASSESSMENT_ENABLED=true

# Agent turns: the chat model searches, reads and answers in one
# tool-calling loop; false is plain retrieve-then-answer. The rounds per
# turn, the seconds a turn may spend before the model must answer, and the
# tool calls the model may make at once in one round. Unset, the rounds
# follow ASSESSMENT_MAX_STEPS, their older name, which is read only then.
# AGENT_TURNS_ENABLED=true
# AGENT_MAX_ROUNDS=6
# AGENT_TIME_BUDGET_S=120
# AGENT_MAX_CALLS_PER_ROUND=4
# ASSESSMENT_MAX_STEPS=

# SUMMARY_COVERAGE_TARGET=0.70
# SUMMARY_MAX_LLM_CALLS=500

# Build the collection summary at the end of an ingest; the ingest screen's
# Summary toggle overrides it per run.
# SUMMARY_ON_INGEST=true

# --- Topics ---

# Scalable collection clustering (docs/topics.md). The fit runs in the
# vllm-service topics service (TOPICS_API_* under Inference); with topics on
# and no service reachable, a build fails with a coded warning. A number
# docint cannot use logs a warning; docs/configuration.md says what it falls
# back to.
#
# The switch covers the routes, the jobs, the ingest stage, the agent tool
# and the SPA screens. On ingest, a run builds or extends the topics (the
# ingest screen's Topics toggle overrides it per run); with that option off,
# a run still aligns its chunks to the active run (no model call). Labels:
# the chat model labels and summarizes each topic; off, a topic is named by
# its first four keywords.
# TOPICS_ENABLED=true
# TOPICS_ON_INGEST=true
# TOPICS_ALIGN_ON_INGEST=true
# TOPICS_LABELS=true

# The most chunks one fit samples, and the shortest chunk text (characters)
# that joins a fit; shorter ones are still assigned. The seed (0..2^32-1)
# drives sampling and the fit.
# TOPICS_FIT_MAX_POINTS=100000
# TOPICS_MIN_TEXT_CHARS=40
# TOPICS_SEED=42

# The smallest topic: 0 sizes it from the sample of n chunks, round(sqrt(n) /
# 3) within 2..10, and from 813 chunks n // 1000 within 10..100. The
# topic-reduction target: 0 keeps every topic found.
# TOPICS_MIN_TOPIC_SIZE=0
# TOPICS_MAX_TOPICS=0

# The percentile (0..100) of a topic's member cosines that sets its floor,
# and the centre cosine (0..1] at which a found topic repeats an existing
# one.
# TOPICS_ADMIT_PERCENTILE=5
# TOPICS_MERGE_MIN_SIMILARITY=0.7

# Topics jobs at once; a build holds its sample's vectors in memory.
# DOCINT_TOPICS_CONCURRENCY=1

# --- Storage ---

# A full SQLAlchemy URL for the session store; set, it wins outright over
# SESSIONS_DB_PATH.
# SESSION_STORE=

# Vector quantization: turbo trades a little recall for much less RAM (turbo
# or none; the bits are bits4, bits2, bits1_5 or bits1).
# QDRANT_QUANTIZATION=turbo
# QDRANT_TURBOQUANT_BITS=bits4

# --- Extracts ---

# Extract bundles (docs/extracts.md): bundles kept per collection; the units
# above which the combined PDF is skipped (0 disables it), and the same cap
# in figures; the units above which a per-source download queues a job.
# EXTRACT_MAX_PER_COLLECTION=5
# EXTRACT_PDF_MAX_UNITS=200
# EXTRACT_PDF_MAX_FIGURES=400
# EXTRACT_SYNC_MAX_UNITS=50
# DOCINT_EXTRACT_CONCURRENCY=1

# --- Frontend ---

# The upload limit is read by BOTH the backend (advertised via GET /config so
# the SPA sizes upload batches) and the frontend nginx (which enforces it),
# which compose gives the same value.
# DOCINT_CLIENT_MAX_BODY_SIZE=1g

# nginx's request-body cap on the JSON API locations (report batch add); read
# by the frontend only.
# DOCINT_API_MAX_BODY_SIZE=64m

# FRONTEND_COLLECTION_TIMEOUT=120

# The most findings one "Add all" may put in a report. Bound into the request
# model at import (restart to change) and advertised via GET /config, so the
# SPA refuses an oversize section against the number the API enforces.
# REPORT_BATCH_MAX_ITEMS=2000

# Read by Vite when the SPA is built, from that build's environment; the
# Docker build passes none. Unset, the SPA derives its API base from
# BASE_URL, which is what the edge gateway's /docint/ sub-path needs; set, it
# is used verbatim (a standalone build outside the gateway).
# VITE_API_BASE_URL=

# =============================================================================
# Audit & retention
# =============================================================================

# Data-protection audit log (docs/audit.md); lines go to stdout. The actions
# that need a stated purpose: X-Audit-Purpose on a request, which the SPA's
# purpose bar sends, or CASE_REF= / REASON= on a make target. Unset, compose
# requires one for query,disclose: searches, chats, listings, previews and
# downloads are refused (428; a command exits 2) until a purpose is stated.
# Set it empty, uncommented, to require none, or list other actions; an
# unknown action stops startup. A command's operator and purpose are per run
# (the make targets pass AUDIT_CLI_USER, AUDIT_CASE_REF and AUDIT_REASON):
# never set those here.
# AUDIT_REQUIRE_PURPOSE=query,disclose

# Document retention (docs/retention.md): every document is deleted this many
# days after its ingest, and what is built from it no later. Whole days from
# 1 to 3650, or off, which is for development only.
# `make retention-report DAYS=N` shows what another period would do.
# DOCUMENT_RETENTION_DAYS=365

# Days (1..365) an item is listed for its owner before its deletion, and the
# grace after a change of period.
# RETENTION_NOTICE_DAYS=30

# Days after which a stored extract bundle is pruned; at least 1.
# EXTRACT_RETENTION_DAYS=7

# =============================================================================
# Development only
# =============================================================================

# The SPA's host port under the dev overlay (make up-dev).
# [dev]
# DOCINT_HOST_PORT=8080

# A fallback identity for local and single-user runs, used when a request
# carries no identity header. Production leaves it unset, so such a request
# is answered 401; set, the backend stops failing closed. It is ignored, with
# one startup warning, whenever DOCINT_EDGE_SECRET is set, and so is the
# fallback DOCINT_DEFAULT_GROUPS. For example
#   DOCINT_DEFAULT_IDENTITY=operator
# [dev]
# DOCINT_DEFAULT_IDENTITY=

# --- Outside Docker only ---

# docker/compose.yaml fixes these on the backend: the paths to volume paths,
# because the $HOME-derived defaults are unwritable in the hardened
# container; the Qdrant URL to the qdrant alias on data-net; the audit output
# to container. A value here therefore applies only to a run outside Docker.
# [dev]
# QDRANT_HOST=http://localhost:6333

# Consulted only while SESSION_STORE is unset.
# [dev]
# SESSIONS_DB_PATH=~/docint/sessions.sqlite3

# stdout (unset) or container, the container's main stdout under one
# container-wide lock, so that CLI runs via `docker compose exec` land in the
# backend's own log.
# [dev]
# AUDIT_OUTPUT=

# [dev]
# DATA_PATH=~/docint/data
# [dev]
# QDRANT_SRC_DIR=~/docint/qdrant_sources
# [dev]
# RESULTS_PATH=~/docint/results
# [dev]
# PIPELINE_ARTIFACTS_DIR=~/docint/artifacts

# Rendered collection extracts.
# [dev]
# EXTRACT_DIR=~/docint/extracts

# Topic runs; refused inside QDRANT_SRC_DIR or PIPELINE_ARTIFACTS_DIR.
# [dev]
# TOPICS_DIR=~/docint/topics
